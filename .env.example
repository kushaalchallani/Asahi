# Asahi Environment Variables

# Required
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/asahi
ASAHI_SECRET_KEY=change-this-to-a-secure-random-string

# Frontend
VITE_API_URL=http://localhost:8000

# Optional
# Set this to your Supabase project URL if using Supabase
# SUPABASE_PROJECT_URL=https://your-project.supabase.co